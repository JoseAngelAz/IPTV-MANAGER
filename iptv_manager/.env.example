SECRET_KEY=change-this-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=your-domain.com,www.your-domain.com

DB_NAME=iptv_manager
DB_USER=iptv_user
DB_PASSWORD=change-this-to-a-strong-password
DB_HOST=db
DB_PORT=5432

# HTTPS mode (behind Nginx)
HTTPS=True

# Use SQLite for local dev, PostgreSQL for production
USE_SQLITE=False

# Axes brute force protection
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_TIME=1

# WhatsApp API (whatsapp-api service running on port 3000)
WHATSAPP_API_URL=http://whatsapp:3000/api/send
